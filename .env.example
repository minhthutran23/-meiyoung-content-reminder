# Cong server
PORT=3000

# Chuoi bat ky, dai, kho doan - dung de bao ve endpoint /upload va /status
ADMIN_TOKEN=change_me_to_a_long_random_string

# --- Cau hinh gui email (mac dinh vi du cho Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Email dung de GUI di. Neu dung Gmail: bat 2-Step Verification roi tao
# "App Password" tai myaccount.google.com/apppasswords - dan vao SMTP_PASS,
# KHONG dung mat khau Gmail thuong.
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your_app_password

# Email se NHAN duoc nhac lich (co the trung voi SMTP_USER)
REMINDER_EMAIL_TO=your-email@gmail.com
